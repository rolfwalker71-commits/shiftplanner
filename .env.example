# App
APP_URL=http://localhost:5173
API_PORT=3001
SESSION_SECRET=change-me-to-a-long-random-string
DEMO_MODE=true
TZ=Europe/Zurich

# Database (SQLite file is created automatically)
DATABASE_URL="file:../data/schichtklar.db"

# CalDAV (iCloud, Infomaniak, Nextcloud, Fastmail, mailbox.org …)
# Set to enable "Mit Kalenderkonto anmelden" against this server, e.g.
# https://sync.infomaniak.com, https://caldav.icloud.com, https://cloud.example.ch/remote.php/dav
# Without it, a CalDAV account can still be connected under Einstellungen.
CALDAV_SERVER_URL=

# Google OAuth + Calendar (optional in DEMO_MODE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
# Comma-separated accounts (Google e-mail or CalDAV username) that may sign in (empty = anyone)
ALLOWED_EMAILS=valentyna@valentoys.ch

# OpenAI Images (optional — without a key, placeholders are used)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_VISION_MODEL=gpt-4o

# Day-before push reminder (VAPID keys are created automatically and stored in the database)
NOTIFY_HOUR=18
